					"raw": "{\r\n  \"name\": \"Test Apartment\",\r\n  \"summary\": \"Простора квартира у центрі Вінниці\",\r\n  \"bedrooms\": 2,\r\n  \"bathrooms\": 1,\r\n  \"price\": 120,\r\n  \"address\": {\r\n    \"street\": \"вул. Галицька, 12\",\r\n    \"market\": \"Vinnytsja\"\r\n  },\r\n  \"amenities\": [\r\n    \"WiFi\",\r\n    \"Кухня\",\r\n    \"Опалення\"\r\n  ],\r\n  \"host\": {\r\n    \"name\": \"Vladyslav\",\r\n    \"superhost\": true\r\n  }\r\n}\r\n",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "http://localhost:3000/api/listingsAndReviews",
					"protocol": "http",
					"host": [
						"localhost"
					],
