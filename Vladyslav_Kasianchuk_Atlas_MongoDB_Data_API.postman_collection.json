	"item": [
		{
			"name": "Create new Document",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Статус-код має бути 201\", function () {\r",
							"    pm.response.to.have.status(201);\r",
							"});\r",
							"\r",
							"pm.test(\"Респонс повинен містити _id\", function () {\r",
							"    var jsonData = pm.response.json();\r",
							"    pm.expect(jsonData).to.have.property(\"_id\");\r",
							"});\r",
							"\r",
							"pm.collectionVariables.set(\"apartmentId\", pm.response.json()._id);\r",
							"\r",
							"pm.test(\"Валідація JSON-схеми відповіді\", function () {\r",
							"    var jsonData = pm.response.json();\r",
							"\r",
							"    var schema = {\r",
							"        \"type\": \"object\",\r",
							"        \"required\": [\"_id\", \"name\", \"summary\", \"bedrooms\", \"bathrooms\", \"price\", \"address\", \"amenities\", \"host\", \"createdAt\"],\r",
							"        \"properties\": {\r",
							"            \"_id\": { \"type\": \"string\" },\r",
							"            \"name\": { \"type\": \"string\" },\r",
							"            \"summary\": { \"type\": \"string\" },\r",
							"            \"bedrooms\": { \"type\": \"number\" },\r",
							"            \"bathrooms\": { \"type\": \"number\" },\r",
							"            \"price\": { \"type\": \"number\" },\r",
							"            \"address\": {\r",
							"                \"type\": \"object\",\r",
							"                \"required\": [\"street\", \"market\"],\r",
							"                \"properties\": {\r",
							"                    \"street\": { \"type\": \"string\" },\r",
							"                    \"market\": { \"type\": \"string\" }\r",
							"                }\r",
							"            },\r",
							"            \"amenities\": {\r",
							"                \"type\": \"array\",\r",
							"                \"items\": { \"type\": \"string\" }\r",
							"            },\r",
							"            \"host\": {\r",
							"                \"type\": \"object\",\r",
							"                \"required\": [\"name\", \"superhost\"],\r",
							"                \"properties\": {\r",
							"                    \"name\": { \"type\": \"string\" },\r",
							"                    \"superhost\": { \"type\": \"boolean\" }\r",
							"                }\r",
							"            },\r",
							"            \"createdAt\": { \"type\": \"string\", \"format\": \"date-time\" }\r",
							"        }\r",
							"    };\r",
							"\r",
							"    pm.expect(tv4.validate(jsonData, schema)).to.be.true;\r",
							"});\r",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
