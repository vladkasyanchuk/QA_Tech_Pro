		{
			"name": "Get document by id",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Статус відповіді — 200 OK\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"pm.test(\"Content-Type — JSON\", function () {\r",
							"    pm.response.to.have.header(\"Content-Type\", \"application/json; charset=utf-8\");\r",
							"});\r",
							"\r",
							"pm.test(\"Об'єкт має всі ключові поля\", function () {\r",
							"    const jsonData = pm.response.json();\r",
							"    pm.expect(jsonData).to.have.property(\"_id\");\r",
							"    pm.expect(jsonData).to.have.property(\"name\");\r",
							"    pm.expect(jsonData).to.have.property(\"summary\");\r",
							"    pm.expect(jsonData).to.have.property(\"bedrooms\");\r",
							"    pm.expect(jsonData).to.have.property(\"bathrooms\");\r",
							"    pm.expect(jsonData).to.have.property(\"price\");\r",
							"    pm.expect(jsonData).to.have.property(\"address\");\r",
							"    pm.expect(jsonData).to.have.property(\"amenities\");\r",
							"    pm.expect(jsonData).to.have.property(\"host\");\r",
							"    pm.expect(jsonData).to.have.property(\"createdAt\");\r",
							"});\r",
							"\r",
							"pm.test(\"Типи даних правильні\", function () {\r",
							"    const data = pm.response.json();\r",
							"    pm.expect(data.name).to.be.a(\"string\");\r",
							"    pm.expect(data.summary).to.be.a(\"string\");\r",
							"    pm.expect(data.bedrooms).to.be.a(\"number\");\r",
							"    pm.expect(data.bathrooms).to.be.a(\"number\");\r",
							"    pm.expect(data.price).to.be.a(\"number\");\r",
							"    pm.expect(data.address.street).to.be.a(\"string\");\r",
							"    pm.expect(data.address.market).to.be.a(\"string\");\r",
							"    pm.expect(data.amenities).to.be.an(\"array\");\r",
							"    pm.expect(data.host.name).to.be.a(\"string\");\r",
							"    pm.expect(data.host.superhost).to.be.a(\"boolean\");\r",
							"    pm.expect(Date.parse(data.createdAt)).to.not.be.NaN;\r",
							"});"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
